{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Configure Pico W",
      "type": "shell",
      "command": "cmake --preset pico-w",
      "problemMatcher": []
    },
    {
      "label": "Build Pico W",
      "type": "shell",
      "command": "cmake --build --preset pico-w",
      "dependsOn": "Configure Pico W",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Flash Pico W",
      "type": "shell",
      "command": "powershell -ExecutionPolicy Bypass -File \"${workspaceFolder}\\flash.ps1\"",
      "dependsOn": "Build Pico W",
      "problemMatcher": []
    }
  ]
}
