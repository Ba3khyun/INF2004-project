{
    "configurations": [
        {
            "name": "Pico RP2040",
            "compilerPath": "C:\\Program Files\\Raspberry Pi\\Pico SDK v1.5.1\\gcc-arm-none-eabi\\bin\\arm-none-eabi-gcc.exe",
            "intelliSenseMode": "gcc-arm",
            "cStandard": "gnu11",
            "includePath": [
                "${workspaceFolder}/**",
                "${workspaceFolder}/include",
                "${workspaceFolder}/config",
                "${workspaceFolder}/kernel/knlinc",
                "${workspaceFolder}/mtkernel_3",
                "${env:PICO_SDK_PATH}/**"
            ],
            "defines": [
                "_PICO_RP2040_",
                "CNF_SMP=1",
                "APP_TEST=0",
                "TM_CONSOLE_UART=0",
                "BOARD_UART0_FREE=1",
                "PICO_RP2040=1",
                "PICO_32BIT=1",
                "PICO_ON_DEVICE=1",
                "PICO_BUILD=1",
                "PICO_NO_HARDWARE=0",
                "RASPBERRYPI_PICO_W=1",
                "TM_CONSOLE_USB_CDC=1",
                "TM_WIFI_CYW43=1",
                "CYW43_LWIP=0",
                "CYW43_ENABLE_BLUETOOTH=0",
                "CYW43_USE_OTP_MAC=1",
                "PICO_CYW43_LOGGING_ENABLED=0"
            ],
            "compilerArgs": [
                "-mcpu=cortex-m0plus",
                "-mthumb",
                "-mfloat-abi=soft",
                "-ffreestanding"
            ],
            "browse": {
                "path": [
                    "${workspaceFolder}",
                    "${env:PICO_SDK_PATH}"
                ],
                "limitSymbolsToIncludedHeaders": true
            }
        }
    ],
    "version": 4
}
